{
  "name": "odb-holdings-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate_site.mjs",
    "check:d1-bindings": "node scripts/check_wrangler_d1_ids.mjs",
    "build": "npm run validate && npm run check:d1-bindings && tsc --noEmit",
    "dev": "wrangler dev --local --port 8787",
    "test": "vitest run",
    "deploy:dry-run": "npm run check:d1-bindings && wrangler deploy --dry-run",
    "deploy:preview": "npm run check:d1-bindings && wrangler deploy --env preview",
    "deploy:production": "npm run check:d1-bindings && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260520.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13",
    "wrangler": "^4.15.0"
  },
  "overrides": {
    "ws": "^8.20.1"
  }
}
